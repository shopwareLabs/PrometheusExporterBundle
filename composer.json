{
    "name": "shopware/prometheus-exporter",
    "description": "Prometheus pull transport for Shopware's telemetry metrics abstraction",
    "version": "1.0.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Shopware\\PrometheusExporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shopware\\PrometheusExporter\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.12 || ~6.8.0",
        "promphp/prometheus_client_php": "^2.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "predis/predis": "^2.3"
    },
    "suggest": {
        "ext-redis": "Required when the metric storage uses a phpredis connection (via shopware.redis.connections or storage.dsn)",
        "predis/predis": "Alternative supported Redis client for the metric storage"
    },
    "extra": {
        "shopware-platform-plugin": "Shopware\\PrometheusExporter\\PrometheusExporterBundle",
        "label": {
            "en-GB": "Prometheus Exporter",
            "de-DE": "Prometheus Exporter"
        }
    }
}
